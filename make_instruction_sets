import os
import datetime
from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google_auth_oauthlib.flow import InstalledAppFlow
from googleapiclient.discovery import build
from googleapiclient.http import MediaFileUpload

# If modifying these scopes, delete the file token.json.
SCOPES = ['https://www.googleapis.com/auth/drive.file']


def authenticate_gdrive():
    creds = None
    if os.path.exists('token.json'):
        creds = Credentials.from_authorized_user_file('token.json', SCOPES)
    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            flow = InstalledAppFlow.from_client_secrets_file('credentials.json', SCOPES)
            creds = flow.run_local_server(port=0)
        with open('token.json', 'w') as token:
            token.write(creds.to_json())
    return build('drive', 'v3', credentials=creds)


def create_new_folder(service, parent_folder_id, folder_name):
    file_metadata = {
        'name': folder_name,
        'mimeType': 'application/vnd.google-apps.folder',
        'parents': [parent_folder_id]
    }
    folder = service.files().create(body=file_metadata, fields='id').execute()
    return folder.get('id')


def upload_to_gdrive(service, file_path, target_folder_id):
    file_name = os.path.basename(file_path)
    file_metadata = {
        'name': file_name,
        'parents': [target_folder_id]
    }
    media = MediaFileUpload(file_path, mimetype='text/plain', resumable=True)
    file = service.files().create(body=file_metadata, media_body=media, fields='id').execute()
    return file.get('id')


def generate_instruction_set():
    print("--- Instruction Set Builder (Custom Variable Edition) ---")

    parent_gdrive_folder_id = input(
        "Enter the ID of the TARGET Parent Google Drive Folder [Press Enter for Default]: ").strip() or "placeholderfolderIDhere"

    # 1. Variable Schema Selection
    use_defaults = input("\nDo you want to use the default variable schema? (Y/n): ").strip().lower()

    variables = {}
    receipt_log = []
    print("\n--- Variable Assignation Phase ---")

    if use_defaults in ['', 'y', 'yes']:
        default_vars = {
            "gdrive_target_id": "placeholderfolderIDhere1",
            "txt_terms_path": "placeholderabsolutepathhere",
            "max_retries": "1000",
            "max_hierarchy": "1000",
            "abridged": "False",
            "max_chars": "50",
            "cooldown_seconds": "1.0",
            "debug_mode": "n",
            "run": "placeholderabsolutepathhere1"
        }
        for key, current_val in default_vars.items():
            new_val = input(f"Assign value for '{key}' [Current: {current_val}]: ").strip()
            # If user presses enter, keep current_val. Otherwise, use new_val.
            variables[key] = new_val if new_val else current_val
            receipt_log.append(f"RECEIPT: Assigned '{variables[key]}' to '{key}'")
    else:
        print("Enter your custom variables. Leave the variable name blank and press Enter when finished.")
        while True:
            var_name = input("Enter custom variable name (or press Enter to finish): ").strip()
            if not var_name:
                break
            var_value = input(f"Enter value for '{var_name}': ").strip()
            variables[var_name] = var_value
            receipt_log.append(f"RECEIPT: Assigned '{var_value}' to '{var_name}'")

    output_blocks = []
    current_subprocess = 1

    try:
        device_count = int(input("\nHow many device numbers are you distributing items across? "))
    except ValueError:
        print("Invalid input.")
        return

    # 2. Data Collection Loop
    for i in range(device_count):
        device_id = input(f"\nEnter ID for Device {i + 1}: ")
        try:
            func_count = int(input(f"  Number of FUNCTIONAL items for Device {device_id}: "))
            non_func_count = int(input(f"  Number of NOT FUNCTIONAL items for Device {device_id}: "))
        except ValueError:
            print("  Invalid count. Skipping this device.")
            continue

        # Helper to build blocks dynamically based on the final variables dictionary
        def build_block(status):
            nonlocal current_subprocess
            block = [f"[Subprocess {current_subprocess}: {status}]"]
            block.append(f"target_device: {device_id}")
            for key, val in variables.items():
                block.append(f"{key}: {val}")
            current_subprocess += 1
            return "\n".join(block)

        for _ in range(func_count):
            output_blocks.append(build_block("FUNCTIONAL"))
        for _ in range(non_func_count):
            output_blocks.append(build_block("NOT FUNCTIONAL"))

    # 3. Final Output Construction + Receipt
    final_text = "\n\n".join(output_blocks)
    final_text += "\n\n--- VALUE ASSIGNATION RECEIPT ---\n"
    final_text += f"Timestamp: {datetime.datetime.now()}\n"
    final_text += "\n".join(receipt_log)

    file_name = "instruction_set_output.txt"
    with open(file_name, "w") as f:
        f.write(final_text)

    # 4. GDrive Upload
    try:
        drive_service = authenticate_gdrive()
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
        new_folder_name = f"Instruction_Set_Run_{timestamp}"
        new_folder_id = create_new_folder(drive_service, parent_gdrive_folder_id, new_folder_name)

        uploaded_file_id = upload_to_gdrive(drive_service, file_name, new_folder_id)

        print(f"\n[SUCCESS] Folder ID: {new_folder_id}")
        print(f"[SUCCESS] File uploaded with ID: {uploaded_file_id}")
        return new_folder_id
    except Exception as e:
        print(f"\nError: {e}")


